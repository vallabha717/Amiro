{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Amiro",
  "description": "Amiro is your own AI agent, on your own machine. This guide shows how to install it and use it day to day \u2014 research, documents, schedules, connectors, its own desktop, a team of agents and voice \u2014 with a video for every setup step.",
  "colors": {
    "primary": "#E9642F",
    "light": "#F59A6B",
    "dark": "#C2471B"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://github.com/vallabha717/Amiro"
  },
  "favicon": "/logo/favicon.svg",
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FFFAF5",
      "dark": "#15110E"
    }
  },
  "fonts": {
    "heading": {
      "family": "Fraunces",
      "weight": 600
    },
    "body": {
      "family": "Geist"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search the Amiro docs\u2026"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor"
    ]
  },
  "banner": {
    "content": "**Amiro v1.27.0 is out:** the agent's live desktop (TV), Team agents, phone pairing with a code, and the Inbox cleanup playbook. [See it in action \u2192](/showcase) \u00b7 [Download \u2192](https://github.com/vallabha717/Amiro/releases/latest)",
    "dismissible": true,
    "color": {
      "light": "#E9642F",
      "dark": "#C2471B"
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/vallabha717/Amiro"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://github.com/vallabha717/Amiro/releases/latest"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "showcase",
              "quickstart",
              "installation",
              "first-run"
            ]
          }
        ]
      },
      {
        "tab": "Using Amiro",
        "groups": [
          {
            "group": "Day to day",
            "pages": [
              "using/everyday-tasks",
              "using/chatting",
              "using/threads-and-history",
              "using/workspace-files",
              "using/search",
              "using/export-and-share"
            ]
          },
          {
            "group": "Your agent",
            "pages": [
              "using/personalizing-your-agent",
              "using/memory",
              "using/skills-superpowers",
              "using/voice",
              "using/agent-desktop",
              "using/team"
            ]
          },
          {
            "group": "Automation and tools",
            "pages": [
              "using/schedules",
              "using/notifications",
              "using/connectors",
              "using/credentials",
              "using/devices"
            ]
          }
        ]
      },
      {
        "tab": "Settings",
        "groups": [
          {
            "group": "Settings",
            "pages": [
              "settings/overview-tour",
              "settings/account",
              "settings/providers",
              "settings/updates",
              "settings/troubleshooting",
              "settings/where-settings-live"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/api-overview",
              "reference/chat-api",
              "reference/agent-api",
              "reference/schedules-api",
              "reference/voice-api",
              "reference/cli-essentials",
              "reference/faq"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/vallabha717/Amiro"
    },
    "links": [
      {
        "header": "Get Amiro",
        "items": [
          {
            "label": "Latest release",
            "href": "https://github.com/vallabha717/Amiro/releases/latest"
          },
          {
            "label": "Install on a server",
            "href": "/installation"
          },
          {
            "label": "Quickstart",
            "href": "/quickstart"
          }
        ]
      },
      {
        "header": "Project",
        "items": [
          {
            "label": "Source code",
            "href": "https://github.com/vallabha717/Amiro"
          },
          {
            "label": "Report an issue",
            "href": "https://github.com/vallabha717/Amiro/issues/new/choose"
          },
          {
            "label": "Security",
            "href": "https://github.com/vallabha717/Amiro/security/policy"
          }
        ]
      }
    ]
  },
  "thumbnails": {
    "preset": "headline",
    "surface": "brand"
  }
}
