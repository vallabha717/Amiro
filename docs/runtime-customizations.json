{
  "schemaVersion": 1,
  "upstreamRepository": "https://github.com/1jehuang/jcode",
  "recordedUpstreamCommit": "11952e02ac76fa1c335633e9c6113691c1cf3395",
  "initialVendorCommit": "de88011ca23601a7af49241c2e69e459d680191d",
  "scope": "Baseline preservation inventory, not an exhaustive patch set or automatic importer. Refresh from the selected clean Amiro revision before every update.",
  "normalizer": {
    "status": "not-implemented",
    "requiredGate": "Bootstrap a versioned deterministic rebrand/exclusion transform and prove the old-normalized plus complete local delta reproduces the tracked current runtime before merging new upstream."
  },
  "areas": [
    {
      "id": "branding-legal-build",
      "requirement": "Preserve Amiro package/binary identities, valid SDK path dependencies, upstream license and build inputs while retaining real upstream service identities.",
      "sentinels": [
        {
          "path": "runtime/Cargo.toml",
          "contains": ["name = \"amiro-runtime\"", "amiro_runtime"]
        },
        {
          "path": "runtime/LICENSE",
          "contains": ["MIT License", "Jeremy Huang"]
        },
        {
          "path": "backend/Cargo.toml",
          "contains": [
            "../runtime/crates/amiro-sdk",
            "../runtime/crates/amiro-session-types",
            "../runtime/crates/amiro-config-types"
          ]
        }
      ],
      "checks": [
        "cargo check --locked --manifest-path runtime/Cargo.toml --no-default-features --bin amiro-runtime",
        "bash scripts/build-native.sh --debug"
      ]
    },
    {
      "id": "fork-service-policy",
      "requirement": "Updater and upstream telemetry remain default-deny, including all newly introduced call sites.",
      "sentinels": [
        {
          "path": "runtime/crates/amiro-build-meta/src/fork_policy.rs",
          "contains": [
            "AMIRO_ALLOW_UPSTREAM_UPDATE",
            "AMIRO_ALLOW_UPSTREAM_TELEMETRY",
            "upstream_services_are_disabled_by_default"
          ]
        },
        {
          "path": "runtime/crates/amiro-app-core/src/update.rs",
          "contains": ["upstream_auto_update_enabled"]
        },
        {
          "path": "runtime/src/cli/startup.rs",
          "contains": ["upstream_auto_update_enabled"]
        },
        {
          "path": "runtime/crates/amiro-telemetry-core/src/lib.rs",
          "contains": ["upstream_telemetry_enabled"]
        }
      ],
      "checks": [
        "cargo test --locked --manifest-path runtime/Cargo.toml -p amiro-build-meta"
      ]
    },
    {
      "id": "configured-search",
      "requirement": "Configured-only provider selection/fallback, selected-default native gate and private registry with fail-closed errors.",
      "sentinels": [
        {
          "path": "runtime/crates/amiro-config-types/src/web_search.rs",
          "contains": ["configured_providers_file", "native_enabled"]
        },
        {
          "path": "runtime/crates/amiro-app-core/src/tool/websearch.rs",
          "contains": ["execute_configured", "configured_provider_order"]
        },
        {
          "path": "backend/src/routes/search_providers.rs",
          "contains": [
            "search-providers-runtime.json",
            "inference-provider-native"
          ]
        }
      ],
      "checks": [
        "cargo test --locked --manifest-path runtime/Cargo.toml -p amiro-config-types",
        "node scripts/verify-search-runtime.mjs"
      ]
    },
    {
      "id": "session-titles-and-streaming",
      "requirement": "No-inference runtime prompt titles/effective session metadata, multi-segment streaming, tool/reasoning history and backend ownership/manual/stale mapping guards.",
      "sentinels": [
        {
          "path": "runtime/crates/amiro-session-types/src/title.rs",
          "contains": ["prompt_title"]
        },
        {
          "path": "backend/src/chat.rs",
          "contains": ["prompt_title", "data-thread-title", "SessionRenamed"]
        },
        {
          "path": "backend/src/threads.rs",
          "contains": ["sync_runtime_title", "titleSource", "manual"]
        },
        {
          "path": "backend/tests/runtime_titles.rs",
          "contains": [
            "runtime_titles_preserve_ownership_session_mapping_and_manual_renames"
          ]
        }
      ],
      "checks": [
        "cargo test --locked --manifest-path runtime/Cargo.toml -p amiro-session-types -p amiro-message-types -p amiro-sdk",
        "cargo test --locked --manifest-path backend/Cargo.toml",
        "node scripts/verify-runtime-titles.mjs"
      ]
    },
    {
      "id": "mcp-runtime-command",
      "requirement": "Preserve reload wire command, connection lifecycle, eager tool cap and every additional committed MCP patch in the chosen revision.",
      "sentinels": [
        {
          "path": "runtime/crates/amiro-harness-api/src/runtime_commands.rs",
          "contains": ["McpReload", "mcp_reload"]
        },
        {
          "path": "runtime/crates/amiro-app-core/src/server/runtime_commands.rs",
          "contains": ["McpReload"]
        },
        {
          "path": "runtime/crates/amiro-base/src/mcp/manager.rs",
          "contains": ["McpManager"]
        }
      ],
      "checks": [
        "cargo test --locked --manifest-path runtime/Cargo.toml -p amiro-harness-api -p amiro-sdk",
        "cargo test --locked --manifest-path backend/Cargo.toml --test composio"
      ]
    },
    {
      "id": "homes-storage-auth",
      "requirement": "Preserve app/runtime home separation, credential/session/memory serialization and legacy home resolution. Verify prior-version data and rollback on staging.",
      "sentinels": [
        {
          "path": "runtime/crates/amiro-storage/src/lib.rs",
          "contains": ["RUNTIME_HOME_ENV_ORDER", "JCODE_HOME"]
        },
        {
          "path": "backend/src/state.rs",
          "contains": ["AMIRO_RUNTIME_HOME", "AMIRO_HOME"]
        },
        {
          "path": "backend/src/runtime.rs",
          "contains": ["AMIRO_TOOL_PROFILE", "expose_tools"]
        },
        {
          "path": "backend/src/credentials.rs",
          "contains": ["store.key", "credentials.enc"]
        }
      ],
      "checks": [
        "cargo test --locked --manifest-path runtime/Cargo.toml -p amiro-storage",
        "cargo test --locked --manifest-path backend/Cargo.toml",
        "node scripts/verify-settings-workflows.mjs",
        "target-specific prior-state migration and rollback rehearsal"
      ]
    }
  ],
  "mandatoryFiles": [
    "scripts/build-native.sh",
    "scripts/verify-search-runtime.mjs",
    "scripts/verify-runtime-titles.mjs",
    "scripts/verify-settings-workflows.mjs",
    "scripts/verify-settings-clarity.mjs",
    "backend/tests/agent_native.rs",
    "backend/tests/composio.rs",
    "backend/tests/credentials.rs",
    "backend/tests/voice.rs",
    "backend/tests/runtime_titles.rs",
    "backend/tests/native_acceptance.rs",
    ".github/workflows/ci.yml"
  ]
}
