# =============================================================================
# Amiro environment reference
# =============================================================================
#
# Amiro reads .env files at startup: AMIRO_ENV_FILE, then ./.env, then
# ~/.amiro/.env (the first to set a key wins; real environment variables
# always win). amiro.toml (see amiro.example.toml and docs/SETUP.md) covers
# the same settings in sections.
#
# Every value below has a working default. An empty file is a valid setup.
#
# Provider keys: ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY and
# GEMINI_API_KEY set in a .env file are imported once into the runtime's
# encrypted credential store at startup (a changed key is imported again).
# OAuth logins are connected from Admin -> Providers or the onboarding wizard.
# =============================================================================


# -----------------------------------------------------------------------------
# Paths and listener
# -----------------------------------------------------------------------------

# Application home: users.json, threads.json, store/, and workspace/.
# Default: ~/.amiro
#AMIRO_HOME=

# Runtime home: memory, sessions, and the runtime's own credential layout.
# This is a DIFFERENT home from AMIRO_HOME. Do not point them at each other.
# Default: $AMIRO_HOME/runtime
#AMIRO_RUNTIME_HOME=

# Interface and port the backend binds. Keep 127.0.0.1 unless you put a real
# auth and TLS story in front of it.
# Defaults: 127.0.0.1 and 8787
#AMIRO_HOST=
#AMIRO_PORT=

# Directory holding the static frontend export to serve.
# Default: the checkout's out/
#AMIRO_OUT_DIR=

# Directory for the runtime bridge's run files.
# Default: $AMIRO_RUNTIME_HOME/run
#AMIRO_RUNTIME_DIR=

# Unix socket the backend uses to reach the runtime bridge.
# Default: $AMIRO_RUNTIME_HOME/amiro-api.sock
#AMIRO_API_SOCKET=

# Path to the amiro-runtime executable. Leave unset to use the built-in
# resolution order: explicit value, then a sidecar next to the backend binary,
# then runtime/target/{release,debug}/amiro-runtime. An explicit value that is
# unusable fails loudly instead of quietly picking a different engine.
#AMIRO_RUNTIME_BIN=


# -----------------------------------------------------------------------------
# Access control
# -----------------------------------------------------------------------------

# Shared secret the backend requires on sidecar requests. Empty means accept
# all, which is only safe while bound to loopback. The Tauri shell generates a
# per-launch value automatically, so you only set this for a manual deployment.
#AMIRO_TOKEN=

# Extra permitted browser origin for cross-origin requests, in addition to the
# request's own Host. Comma- or space-separated if you need more than one.
#AMIRO_ALLOWED_ORIGIN=

# Session lifetime in days. Unset uses the runtime's own default.
#AMIRO_SESSION_TTL_DAYS=


# -----------------------------------------------------------------------------
# First run (owner provisioning)
# -----------------------------------------------------------------------------
#
# There is no default password and no sign-up. On a fresh home the app shows a
# one-time "Set up Amiro" page. To provision the single owner headlessly
# instead, set the owner email and a password source before the FIRST start.
# Provisioning only happens while the user store is empty.
#
#AMIRO_OWNER_EMAIL=owner@example.com
#AMIRO_OWNER_PASSWORD=a-long-owner-password
#AMIRO_OWNER_PASSWORD_FILE=/run/secrets/amiro-owner-password


# -----------------------------------------------------------------------------
# Models
# -----------------------------------------------------------------------------

# provider:model used when a request omits a model. Also makes that provider
# group and model appear first, so a fresh chat lands on a known-working route.
# Example: openrouter:qwen3-8b:free
#AMIRO_DEFAULT_MODEL=

# Hard allow-list of models. When set, only these are listed and anything else
# is rejected with "model not allowed". Comma-separated.
# Example: openai:gpt-5.6-luna,anthropic:claude-sonnet-5
#AMIRO_PINNED_MODELS=


# -----------------------------------------------------------------------------
# Workspace and tools
# -----------------------------------------------------------------------------

# Absolute roots the server-side folder picker may browse, comma-separated.
# Default: /root,/home,/srv,/opt,/var/www,/tmp
#AMIRO_BROWSE_ROOTS=

# Default workspace root for file, edit, search, and git tools.
# Default: $AMIRO_HOME/workspace
#AMIRO_WORKSPACE_ROOT=

# Tools are ON by default and run with the owner's permissions. Amiro is meant
# to run inside a VM or sandbox, and that sandbox is the boundary. Set
# AMIRO_TOOL_PROFILE=none to run chat without tools.
#AMIRO_TOOL_PROFILE=none

# 1 re-enables legacy skill generation, which is off by default.
#AMIRO_ENABLE_SKILL_GENERATION=1


# -----------------------------------------------------------------------------
# Process control
# -----------------------------------------------------------------------------

# 1 makes the backend refuse to start a runtime bridge and require one that is
# already running. Use it when you supervise the runtime yourself.
#AMIRO_NO_RUNTIME_SPAWN=1

# 1 disables the supervisor thread that pings the runtime and restarts it when
# it dies. The daemon exits after five idle minutes without a client.
#AMIRO_NO_RUNTIME_KEEPALIVE=1

# 1 disables the schedule ticker in this process. Use it on a secondary instance
# that shares a home, or in tests.
#AMIRO_NO_SCHEDULER=1

# 1 disables runtime telemetry.
#AMIRO_NO_TELEMETRY=1


# -----------------------------------------------------------------------------
# Frontend development only (baked in at build time by Next.js)
# -----------------------------------------------------------------------------

# Backend base URL the frontend talks to. Must match AMIRO_HOST and AMIRO_PORT.
# Next.js inlines NEXT_PUBLIC_* at build time, so set these before `pnpm build`,
# and note they are public, so never put a secret in one.
#NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8787

# Must match the backend's AMIRO_TOKEN when the backend enforces one.
#NEXT_PUBLIC_BACKEND_TOKEN=


# =============================================================================
# Inherited frontend variables
# =============================================================================
#
# These are read by frontend library modules carried over from the project's
# earlier Next.js-server architecture. The shipped product serves a static
# export from the Rust backend, so they only take effect if you run a Next.js
# server yourself. They are listed because the code does read them, and because
# dropping them from this file would hide that fact. Amiro's own path for
# search and uploads is the backend, configured in the app rather than here.
# =============================================================================

# Exa API key for the legacy web search tool. Its module throws when the key is
# missing, and the current product path for search is the admin Search Providers
# page instead.
#EXA_API_KEY=

# Ollama base URL used by the legacy model factory.
# Default: http://localhost:11434/api
#OLLAMA_BASE_URL=

# "true" selects file-based MCP config in the legacy frontend constants.
#FILE_BASED_MCP_CONFIG=

# Redis URL for the legacy cache layer. Unset falls back to in-process caching.
#REDIS_URL=

# File storage backend for the legacy upload path: "vercel-blob" or "s3".
# Default: vercel-blob
#FILE_STORAGE_TYPE=
#
# When FILE_STORAGE_TYPE=s3:
#FILE_STORAGE_S3_BUCKET=
#FILE_STORAGE_S3_REGION=
# Optional public base URL, for example a CDN in front of the bucket
#FILE_STORAGE_S3_PUBLIC_BASE_URL=
# Optional S3-compatible endpoint, for example MinIO
#FILE_STORAGE_S3_ENDPOINT=
# Set to 1 to force path-style URLs, needed by most S3-compatible endpoints
#FILE_STORAGE_S3_FORCE_PATH_STYLE=
#
# AWS credentials and region. The SDK also auto-discovers credentials from
# ~/.aws/credentials, AWS_PROFILE, or an attached IAM role, so you usually do
# not set these.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
#AWS_REGION=
