{
  "name": "amiro-desktop",
  "version": "1.26.0",
  "private": true,
  "author": "cgoinglove",
  "license": "MIT",
  "type": "module",
  "bin": {
    "amiro": "bin/amiro"
  },
  "scripts": {
    "dev": "next dev clients/web",
    "dev:turbopack": "next dev --turbopack clients/web",
    "adapter": "node adapter/src/server.mjs",
    "adapter:install": "pnpm --dir adapter install",
    "native:build": "bash scripts/build-native.sh",
    "native:dev": "cargo run --manifest-path backend/Cargo.toml --bin amiro-backend",
    "native:test": "cargo test --manifest-path backend/Cargo.toml",
    "runtime:check": "cargo check --manifest-path runtime/Cargo.toml --bin amiro-runtime --no-default-features",
    "desktop:sidecar": "node scripts/build-sidecar.mjs --build",
    "desktop:package": "npx --yes @tauri-apps/cli@^2 build",
    "desktop:start": "bash ./scripts/desktop-app.sh start",
    "desktop:build": "bash ./scripts/desktop-app.sh build",
    "desktop:status": "bash ./scripts/desktop-app.sh status",
    "vm:start": "bash ./scripts/amiro-server.sh start --host 0.0.0.0",
    "vm:status": "bash ./scripts/amiro-server.sh status",
    "vm:urls": "bash ./scripts/amiro-server.sh urls",
    "dev:https": "next dev --experimental-https clients/web",
    "build": "next build clients/web",
    "start": "node adapter/src/server.mjs",
    "build:local": "cross-env NO_HTTPS='1' next build clients/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --dir tests e2e",
    "test:e2e:ui": "pnpm --dir tests e2e --ui",
    "test:native-backend": "cargo test --manifest-path backend/Cargo.toml",
    "verify:native-ui": "bash scripts/start-native-ui-check.sh",
    "verify:schedules-ui": "node scripts/verify-schedules-ui.mjs",
    "lint": "biome lint",
    "lint:fix": "biome lint --write --unsafe",
    "format": "biome format --write",
    "check-types": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "prepare": "husky && node scripts/sync-pdf-worker.mjs",
    "playwright:install": "playwright install",
    "check": "pnpm lint:fix && pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.56",
    "@ai-sdk/google": "^2.0.51",
    "@ai-sdk/groq": "^2.0.33",
    "@ai-sdk/openai": "^2.0.88",
    "@ai-sdk/openai-compatible": "^1.0.29",
    "@ai-sdk/react": "^2.0.118",
    "@ai-sdk/xai": "^2.0.42",
    "@aiden0z/pptx-renderer": "^1.4.0",
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@google/genai": "^1.34.0",
    "@js-preview/excel": "^1.7.14",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@openrouter/ai-sdk-provider": "^1.5.4",
    "@openuidev/react-lang": "^1.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extension-mention": "^2.27.1",
    "@tiptap/pm": "^2.27.1",
    "@tiptap/react": "^2.27.1",
    "@tiptap/starter-kit": "^2.27.1",
    "@tiptap/suggestion": "^2.27.1",
    "@vercel/blob": "^2.0.0",
    "ai": "^5.0.116",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "date-fns": "^4.1.0",
    "deepmerge": "^4.3.1",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "dotenv": "^16.6.1",
    "emoji-picker-react": "^4.16.1",
    "framer-motion": "^12.23.26",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "ioredis": "^5.8.2",
    "json-schema": "^0.4.0",
    "jszip": "3.10.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.486.0",
    "mammoth": "1.11.0",
    "mermaid": "^11.12.2",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "next-intl": "^4.8.1",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "ollama-ai-provider-v2": "^1.5.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "shiki": "^3.20.0",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "ts-edge": "^1.0.4",
    "ts-safe": "^0.0.5",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.18.2",
    "vaul": "^1.1.2",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,json,mjs,ts,yaml,tsx,css}": [
      "pnpm format",
      "pnpm lint:fix"
    ]
  },
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
