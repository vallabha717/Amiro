// Type-checks the web app (clients/web) together with the E2E specs and the
// repo's scripts. The web app's own settings and path aliases live in
// clients/web/tsconfig.json, which Next.js reads.
{
  "extends": "./clients/web/tsconfig.json",
  "include": [
    "clients/web/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "clients/web/.next/types/**/*.ts",
    "clients/web/src/types/global.d.ts",
    "clients/web/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "clients/web/out",
    "clients/desktop",
    "clients/mobile",
    "runtime",
    "backend"
  ]
}
