{
  "name": "@amiro/tests",
  "version": "0.0.0",
  "private": true,
  "description": "Recorded Playwright E2E journeys (tests/e2e). Deliberately NOT part of the root pnpm workspace: Playwright and its browsers must not enter the shipped app's dependency graph.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:onboarding": "playwright test --project onboarding",
    "e2e:provider": "playwright test --project provider",
    "e2e:voice": "playwright test --project voice",
    "e2e:chat": "playwright test --project chat",
    "e2e:connectors": "playwright test --project connectors",
    "e2e:credentials": "playwright test --project credentials",
    "e2e:agent-hub": "playwright test --project agent-hub",
    "e2e:agent-driven": "playwright test --project agent-driven",
    "e2e:voice-live": "playwright test --project voice-live",
    "e2e:schedules": "playwright test --project schedules",
    "e2e:ux-audit": "playwright test --project ux-audit",
    "e2e:notifications": "playwright test --project notifications",
    "test": "playwright test",
    "install-browsers": "playwright install --with-deps chromium",
    "show-report": "playwright show-report",
    "e2e:feature": "node e2e/support/feature-recording.mjs",
    "showcase": "playwright test -c showcase/playwright.config.ts",
    "showcase:export": "node showcase/export-media.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
