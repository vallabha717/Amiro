{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amiro",
  "version": "0.1.0",
  "identifier": "com.amiro.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3210",
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File ./src-tauri/build-sidecar.ps1 && pnpm dev -p 3210",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File ./src-tauri/build-sidecar.ps1 && pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
