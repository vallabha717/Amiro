{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amiro",
  "version": "1.27.0",
  "identifier": "com.amiro.desktop",
  "build": {
    "frontendDist": "../web/out",
    "devUrl": "http://localhost:3210",
    "beforeDevCommand": "node scripts/build-sidecar.mjs --build && pnpm dev -p 3210",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs --build && pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/backend",
      "binaries/runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Productivity",
    "shortDescription": "Your own AI agent",
    "longDescription": "Amiro is a personal AI agent that runs on your computer or your own server.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libnotify-bin"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NEU4MUVCQzI3QzE1RkEKUldUNkZYekM2NEZPQ0N5b2Y4alhPV1NKMnR1UllRa3hQeDlSczl4VjJ2QVNRQmtnRDJmWHA4N0oK",
      "endpoints": [
        "https://github.com/vallabha717/Amiro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
